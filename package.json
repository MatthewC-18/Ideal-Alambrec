    "@radix-ui/react-tabs": "1.1.13",
    "@react-pdf/renderer": "4.3.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.577.0",
    "next": "15.5.27",
    "next-auth": "4.24.15",
    "nodemailer": "7.0.11",
    "react": "19.2.8",
