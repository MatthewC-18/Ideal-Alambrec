# --- Base de datos -----------------------------------------------------------
DATABASE_URL="postgresql://cotizador:cotizador@localhost:5432/cotizador?schema=public"

# --- Sesión (genera uno con: openssl rand -base64 32) ------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo"

# --- SSO Microsoft Entra ID (tenant de Grupo AG) — dejar vacío si no aplica --
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- SSO Google Workspace — dejar vacío si no aplica -------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Acceso piloto (sin SSO): correo del usuario + PIN compartido -------------
# Desactívalo (false) en producción cuando el SSO esté configurado.
PILOT_LOGIN="true"
PILOT_PIN="2026"

# --- Correo saliente (si se deja vacío, los envíos quedan en modo simulado) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Cotizador Ideal Alambrec <cotizaciones@ejemplo.com>"

# --- Semilla -----------------------------------------------------------------
# Archivo Excel desde el que se importan lista de precios y asesores
SEED_EXCEL_PATH="legacy/Cotizador_PRO_V6R02-2026.xlsm"
# Crea clientes y cotizaciones ficticias para la demo (se pueden borrar desde Configuración)
SEED_DEMO_DATA="true"
